        <mxCell id="UXiR0BeScdLjWm2d1sKE-18" parent="1" style="text;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fontColor=default;" value="&lt;div style=&quot;color: #cccccc;background-color: #1f1f1f;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #dcdcaa;&quot;&gt;CanTrcv_SetWakeupMode&lt;/span&gt;&lt;span style=&quot;color: #cccccc;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;CANTRCV_CanTrcvChannel_TJA1145_ChassisCAN1&lt;/span&gt;&lt;span style=&quot;color: #cccccc;&quot;&gt;, CANTRCV_WUMODE_ENABLE);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
