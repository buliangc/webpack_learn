        <mxCell id="HswODp9aRl4NSNwMEvw4-17" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: #cccccc;background-color: #1f1f1f;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* typedef enum&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_ERROR=0, &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Wake up reason not detected due to some error. This may only be reported when error was reported to DEM before &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_NOT_SUPPORTED, &amp;nbsp; The transceiver does not support any information for the wake up reason.\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_BY_BUS, &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;The transceiver has detected, that the network has caused the wake up of the ECU.\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_INTERNALLY, &amp;nbsp; &amp;nbsp; &amp;nbsp;The transceiver has detected, that the network has woken up by the ECU via a request to NORMAL mode. &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_RESET, &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; The transceiver has detected, that the &quot;wake up&quot; is due to an ECU reset. &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_POWER_ON, &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;The transceiver has detected, that the &quot;wake up&quot; is due to an ECU reset after power on.\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* &amp;nbsp;CANTRCV_WU_BY_PIN &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; The transceiver has detected a wake-up event at one of the transceiver&#39;s pins (not at the CAN bus). &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;\n&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #6a9955;&quot;&gt;&amp;nbsp;* }CanTrcv_TrcvWakeupReasonType;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="190" width="920" x="1350" as="geometry" />
        </mxCell>
